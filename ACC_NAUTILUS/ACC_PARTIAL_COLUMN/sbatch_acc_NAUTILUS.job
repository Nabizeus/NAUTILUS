#!/bin/bash
#SBATCH --job-name=ACC_NAUTILUS
#SBATCH -D .
#SBATCH --output=server_acc_%j.out  # %j: JobId
#SBATCH --error=server_acc_%j.err
#SBATCH --ntasks=1              
#SBATCH --time=28:00:00          # Max run time 24:00:00
#SBATCH --account=bsc32
#SBATCH --qos=acc_bsces #gp_debug #acc_bsces up to 24:00:00
#SBATCH --cpus-per-task=20 #64
#SBATCH --gres=gpu:1
#SBATCH --mail-type=all
#SBATCH --mail-user=nabiz.rahpoe@bsc.es


###"""
###from Chiara
### Queue type. Options: ps, SGE, LSF, SLURM, PBS, eceaccess
###TYPE = slurm
###HOST = glogin2.bsc.es
###PROJECT = cns113
##USER = bsc082130
###QUEUE = gp_resa
###SCRATCH_DIR = /gpfs/scratch
##ADD_PROJECT_TO_HOST = false
##MAX_WALLCLOCK = 48:00
###"""


#Vxarray>=2024.1.0
#numpy>=1.24.0
#Vtorch>=2.1.0
#Vpyyaml>=6.0.1
#Vtqdm>=4.66.0
#VnetCDF4>=1.6.5
#Vscipy>=1.11.0
module purge
module load PyYAML/6.0.1-GCCcore-13.2.0
module load tqdm/4.66.2-GCCcore-13.2.0
module load PyTorch/2.3.0-foss-2023b-CUDA-12.4.0
module load imageio/2.34.1-gfbf-2023b
module load scikit-learn/1.4.0-gfbf-2023b
# Make Hydra/OmegaConf from the Intel Python visible
#export PYTHONPATH=/apps/GPP/PYTHON/3.12.1/INTEL/lib/python3.12/site-packages:$PYTHONPATH

#Python 3.12 will only see the python extra files Hydra and Omegaconfig 
# Torch will be CUDA 


HYDRA_PATH="$HOME/python_extra"

if [ ! -d "$HYDRA_PATH" ]; then
    echo "===================================="
    echo "ERROR: Missing Hydra/OmegaConf path:"
    echo "ERROR: Cannot find $HYDRA_PATH"
    echo "===================================="
    exit 1
fi

export PYTHONPATH="$HYDRA_PATH:$PYTHONPATH"

module load xarray/2024.5.0-gfbf-2023b-Python-3.11.5
module load SciPy-bundle/2023.11-gfbf-2023b

# NetCDF backends
module load netcdf4-python/1.7.1.post2-foss-2023b
module load h5netcdf/1.6.1-foss-2023b-Python-3.11.5


echo "Modules Loaded...."

echo "========== GPU CHECK =========="
hostname
date

echo "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
echo "SLURM_GPUS=$SLURM_GPUS"

nvidia-smi








echo "========== ENVIRONMENT =========="
python << EOF
import sys
import torch
import hydra
import omegaconf
import xarray
import sklearn

print("Python     :", sys.executable)
print("Hydra      :", hydra.__version__)
print("OmegaConf  :", omegaconf.__version__)
print("xarray     :", xarray.__version__)
print("Sklearn    :", sklearn.__version__)
print("xarray engines:", list(xarray.backends.list_engines().keys()))



print("Torch:", torch.__version__)
print("CUDA available:", torch.cuda.is_available())
print("CUDA:", torch.version.cuda)
print("GPU count:", torch.cuda.device_count())

if torch.cuda.is_available():
    print("GPU:", torch.cuda.get_device_name(0))
    print(
	"Memory:",
      	torch.cuda.get_device_properties(0).total_memory/1024**3,
      	"GB"
	)
EOF

echo "==============================="





# Files
#dir="/gpfs/scratch/bsc32/bsc032739/a95g/19710101/fc02/runtime/"

#mytrc="a95g_1ts_19710101_19711231_opa_grid_T_2D.nc" 
#mlotst: (ocean_mixed_layer_thickness_defined_by_sigma_theta)
#omld (ocean_mixed_layer_thickness_defined_by_vertical_tracer_diffusivity)
#umo="a95g_1ts_19710101_19711231_opa_grid_U_3D.nc"
#umo Effective ocean transport along i-axis
#vmo="a95g_1ts_19710101_19711231_opa_grid_V_3D.nc"
#vmo Effective ocean transport along j-axis
#wmo="a95g_1ts_19710101_19711231_opa_grid_W_3D.nc"
#wmo effective ocean vertical transport
#difvso vertical salt diffusivity * e3w
#echo "Runtime directory: " $dir


# Run the Ocean Emulator

#echo "Start NAUTILIUS DEBUGGGG"
#python -u -m src.debug_forward --config config/default.yaml > nautilus.log 2>&1
#tail -n +1 nautilus.log
#echo "End training----"



epoch=100
inp=4
lev=5
split=8099
var=6

TIMESTAMP_HH=$(date -u +"%Y_%m_%d_%H:%M:%S")
echo "${TIMESTAMP_HH}"
arch="conv2dlstm_s323D_GPU" 
write_out="/gpfs/scratch/bsc32/bsc032196/nautilus/"${arch}"/depth_"${lev}"_inp_"${inp}"_ep"${epoch}"_splt"${split}"_var"${var}"_2500p/atl_pacf_"${TIMESTAMP_HH}

echo "Writing files prediction, logs, nemo_restart and debugs to GPFS SCRATCH......... ##########"

mkdir -p "${write_out}"
echo "write out to..." ${write_out}
echo ${write_out} >> "list_s323D_exp_gpfs_scratch.dat"

#rm -f profiler/*.*
#rm -f checkpoints/*.pt
#rm -f norms/*.*
#rm -f logs/*.*
#rm -f plots/heatmaps/*.*
#rm -rf artifacts/*
#rm -r predictions/*

#echo "Start NAUTILIUS TRAIN!!!!"
#python -m src.train  > train_acc_nautilus.log 2>&1
#tail -n +1 train_acc_nautilus.log
#echo "End training----"

echo "Start NAUTILIUS PREDICT!!!"
python -m src.predict  > inference_acc_nautilus.log 2>&1 
tail -n +1 inference_acc_nautilus.log
echo "End NAUTILUS ##########"

echo "Err/Out in server..."
rm server/*.*
mv server_*.* server


cp -r config $write_out
cp -r predictions $write_out
cp -r norms $write_out
cp -r logs $write_out
cp -r nemo_restart $write_out
cp -r activations $write_out
cp -r artifacts $write_out
cp -r server $write_out
cp -r checkpoints $write_out
cp -r profiler $write_out


cp sbatch*.job $write_out


echo "Copied current results to GPFS SCRATCH!  ##########" "${write_out}"

