#!/bin/bash
#SBATCH --job-name=NF_benchcc
#SBATCH -D .
#SBATCH --output=server/benchcc_%j.out
#SBATCH --error=server/benchcc_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=112
#SBATCH --cpus-per-task=1
#SBATCH --exclusive
#SBATCH --time=02:00:00
# Every measurement is its own srun step: if one is killed, the job goes on with the next.
#SBATCH --account=bsc32
#SBATCH --qos=gp_debug
# NAUTIFLOWER: CPU inference speed of the Flower models as a coupled NEMO run would see it, on one full GPP
# node (112 cores), with the v7 benchmark of NAUTILUS (src/benchmark_cpu_coupling.py, mask from its logs/).
# Random weights, real ORCA1 land mask, 1 tracer, halo 8 cells (Flower has no fixed reach).
# Every process is one rank with its own NEMO-like subdomain plus halo: 1 x 112 threads (whole domain),
# 8 x 14 and 112 x 1. Each rank times fp32/bf16 x eager/TorchScript (src/benchmark_cpu_coupling.py).
module purge
module load PyYAML/6.0.1-GCCcore-13.2.0 tqdm/4.66.2-GCCcore-13.2.0 PyTorch/2.1.2-foss-2023b-Python-3.11.5 imageio/2.34.1-gfbf-2023b xarray/2024.5.0-gfbf-2023b-Python-3.11.5 SciPy-bundle/2023.11-gfbf-2023b netcdf4-python/1.7.1.post2-foss-2023b
export PYTHONPATH="$HOME/python_extra:$PYTHONPATH"
export PYTHONUNBUFFERED=1
lscpu | grep -E "Model name|^CPU\(s\)|Thread|Core|Socket|amx"| cut -c1-200
echo "git commit: $(git rev-parse --short HEAD 2>/dev/null)"
J=${SLURM_JOB_ID}
MASK=$HOME/NAUTILUS/ACC_NAUTILUS/ACC_FULL_COLUMN_v2/logs/orca1_surface_ocean_mask.npy
for M in nautiflower_2d_k5 nautiflower_3d_k5; do
    echo "######## $(date +%H:%M:%S) ${M}: 1 process x 112 threads, whole domain"
    OMP_NUM_THREADS=112 srun --ntasks=1 --cpus-per-task=112 python -m src.benchmark_cpu_coupling \
        --config config/${M}.yaml --mask $MASK --ranks 1 --rank 0 --repeats 3 --check --out "logs/benchcc_{tag}_{ranks}_{rank}_${J}.json"
    echo "######## $(date +%H:%M:%S) ${M}: 8 processes x 14 threads"
    OMP_NUM_THREADS=14 srun --ntasks=8 --cpus-per-task=14 --cpu-bind=cores python -m src.benchmark_cpu_coupling \
        --config config/${M}.yaml --mask $MASK --repeats 5 --out "logs/benchcc_{tag}_{ranks}_{rank}_${J}.json"
    echo "######## $(date +%H:%M:%S) ${M}: 112 processes x 1 thread"
    OMP_NUM_THREADS=1 srun --ntasks=112 --cpus-per-task=1 --cpu-bind=cores python -m src.benchmark_cpu_coupling \
        --config config/${M}.yaml --mask $MASK --repeats 5 --out "logs/benchcc_{tag}_{ranks}_{rank}_${J}.json"
done
echo "######## $(date +%H:%M:%S) DONE"
